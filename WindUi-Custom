local WINDUI_URL = "https://raw.githubusercontent.com/BadjoClan/Scripts/refs/heads/main/WindUi-Custom"

local HttpService = game:GetService("HttpService")
local GENV = (getgenv and getgenv()) or _G

local Airflow = { Flags = {}, Windows = {}, ScriptName = "Script" }
local WindUI

local function loadWindUI()
	if WindUI then return WindUI end
	local file = GENV.WINDUI_FILE
	local src
	if file and isfile and isfile(file) then
		src = readfile(file)
	else
		src = game:HttpGet(GENV.WINDUI_URL or WINDUI_URL)
	end
	WindUI = loadstring(src)()
	return WindUI
end

local function pick(cfg, ...)
	for _, key in ipairs({ ... }) do
		if cfg[key] ~= nil then return cfg[key] end
	end
end

local function norm(cfg, second)
	if type(cfg) == "string" then return { Name = cfg, Text = cfg, Icon = second } end
	return cfg or {}
end

local function keycode(key)
	if typeof(key) == "EnumItem" then return key end
	if type(key) == "string" then return Enum.KeyCode[key] end
end

local function copyList(t)
	local out = {}
	for i, v in ipairs(t) do out[i] = v end
	return out
end

function Airflow:SetScriptName(name) self.ScriptName = name end
function Airflow:SetPremium() end
function Airflow:MainCredit(opts) self._mainCredit = opts or {} end
function Airflow:Fleet() end
function Airflow:SetTheme(name) return (pcall(function() loadWindUI():SetTheme(name) end)) end

function Airflow:Notify(cfg)
	cfg = norm(cfg)
	loadWindUI():Notify({
		Title = cfg.Title or "Notice",
		Content = pick(cfg, "Content", "Text", "Message"),
		Duration = cfg.Duration or 4,
		Icon = pick(cfg, "Icon", "Image"),
	})
end

local Tab = {}
Tab.__index = Tab

local Window = {}
Window.__index = Window

function Window:_touch() self._lastControl = os.clock() end

function Window:_autoSave()
	if not self._ready or self._savePending then return end
	self._savePending = true
	task.delay(0.5, function()
		self._savePending = false
		pcall(function() self._cfg:Save() end)
	end)
end

function Window:_config(name)
	if not name or name == self._fileName then return self._cfg end
	local cm = self._w.ConfigManager
	local cfg = cm:CreateConfig(name)
	cfg.Elements = self._cfg.Elements
	self._w:SetCurrentConfig(self._cfg)
	return cfg
end

function Window:SaveConfig(name) return self:_config(name):Save() end

function Window:LoadConfig(name, silent)
	local cfg = self:_config(name)
	if not isfile(cfg.Path) then return false end
	local ok = cfg:Load()
	if ok then self._ready = true end
	return ok and true or false
end

function Window:DeleteConfig(name) return self:_config(name):Delete() end

function Window:ListConfigs() return self._w.ConfigManager:AllConfigs() end

function Window:SetKeybind(key)
	local kc = keycode(key)
	if kc then self._w:SetToggleKey(kc) end
end

function Window:Toggle(open)
	if open == nil then self._w:Toggle() elseif open then self._w:Open() else self._w:Close() end
end

function Window:SelectTab(tab) self._w:SelectTab(tab._index) end

function Window:Notify(cfg) Airflow:Notify(cfg) end

function Window:Dialog(cfg)
	local buttons = {}
	for _, b in ipairs(cfg.Buttons or {}) do
		table.insert(buttons, { Title = b.Title, Callback = b.Callback })
	end
	self._w:Dialog({ Title = cfg.Title, Content = cfg.Content, Buttons = buttons })
end

function Window:Confirm(cfg)
	self._w:Dialog({
		Title = cfg.Title,
		Content = cfg.Content,
		Buttons = {
			{ Title = cfg.CancelText or "Cancel", Callback = cfg.OnCancel or function() end },
			{ Title = cfg.ConfirmText or "Confirm", Callback = cfg.Callback or function() end },
		},
	})
end

function Window:Destroy()
	self._dead = true
	pcall(function() self._w:Destroy() end)
	for i, w in ipairs(Airflow.Windows) do
		if w == self then table.remove(Airflow.Windows, i) break end
	end
end

-- Coupe tous les toggles a flag (leurs callbacks arretent les workers), previent le joueur puis detruit la fenetre.
function Window:_unload(reason)
	if self._dead then return end
	for _, C in pairs(Airflow.Flags) do
		if rawget(C, "_isToggle") then
			pcall(function() if C:Get() then C:Set(false) end end)
		end
	end
	Airflow:Notify({ Title = "Passolini", Content = reason, Duration = 10 })
	task.wait(1)
	self:Destroy()
end

function Window:CreateTab(name, icon)
	local cfg = norm(name, icon)
	local t = self._w:Tab({ Title = cfg.Name or cfg.Title, Icon = cfg.Icon or icon })
	self._tabCount = self._tabCount + 1
	if self._tabCount == 1 then
		task.delay(0.2, function()
			if not self._dead then pcall(function() self._w:SelectTab(1) end) end
		end)
	end
	return setmetatable({ Window = self, _t = t, _index = self._tabCount }, Tab)
end
Window.Tab = Window.CreateTab

local Players = game:GetService("Players")

local function fmtDuration(sec)
	sec = math.max(0, math.floor(sec))
	local d, h, m = math.floor(sec / 86400), math.floor(sec % 86400 / 3600), math.floor(sec % 3600 / 60)
	if d > 0 then return d .. "d " .. h .. "h " .. m .. "m" end
	if h > 0 then return h .. "h " .. m .. "m" end
	if m > 0 then return m .. "m" end
	return "<1m"
end

-- Temps passe avec les scripts, un fichier par UserId : <Dossier>/Time/<UserId>.json (partage entre les comptes d'une meme machine).
local function startPlaytime(win, folder, scriptName)
	local player = Players.LocalPlayer
	local dir = folder .. "/Time"
	pcall(function()
		if not isfolder(folder) then makefolder(folder) end
		if not isfolder(dir) then makefolder(dir) end
	end)
	local path = dir .. "/" .. tostring(player.UserId) .. ".json"
	local data = { userId = player.UserId, name = player.Name, total = 0, scripts = {} }
	pcall(function()
		if isfile(path) then
			local saved = HttpService:JSONDecode(readfile(path))
			if type(saved) == "table" then
				data.total = tonumber(saved.total) or 0
				data.scripts = type(saved.scripts) == "table" and saved.scripts or {}
			end
		end
	end)
	local pt = { data = data, dir = dir, session = 0 }
	local function save()
		data.name = player.Name
		data.lastSeen = os.time()
		pcall(writefile, path, HttpService:JSONEncode(data))
	end
	task.spawn(function()
		local last = os.clock()
		while not win._dead do
			task.wait(15)
			local now = os.clock()
			local dt = math.min(now - last, 30)
			last = now
			pt.session = pt.session + dt
			data.total = data.total + dt
			data.scripts[scriptName] = (tonumber(data.scripts[scriptName]) or 0) + dt
			save()
		end
		save()
	end)
	save()
	return pt
end

local function readAccounts(pt)
	local list, seen = {}, {}
	local ok, files = pcall(listfiles, pt.dir)
	if ok and type(files) == "table" then
		for _, f in ipairs(files) do
			local okr, d = pcall(function() return HttpService:JSONDecode(readfile(f)) end)
			if okr and type(d) == "table" and tonumber(d.total) and d.userId ~= pt.data.userId then
				table.insert(list, d)
				seen[d.userId] = true
			end
		end
	end
	table.insert(list, pt.data)
	table.sort(list, function(a, b) return (tonumber(a.total) or 0) > (tonumber(b.total) or 0) end)
	return list
end

local KEY_KINDS = { PASS = "Free key", KIWI = "Free key", LIFE = "Lifetime key", GIFT = "Gift key" }

function Window:_keyTab(info, folder, scriptName)
	local tab = self:CreateTab("Key", "key")
	local pt = startPlaytime(self, folder, scriptName)

	local function keyStatus()
		if info.required == false then
			return (info.message and info.message ~= "") and info.message or "This script is keyless for now: no key needed."
		end
		if not info.valid then return "No key information." end
		local kind = KEY_KINDS[info.kind] or "Key"
		if info.lifetime then return kind .. ": never expires." end
		if not info.expires then return kind .. ": active." end
		local left = info.deadline and (info.deadline - os.clock()) or (info.expires - os.time())
		if left <= 0 then return kind .. ": expired." end
		return kind .. ": " .. fmtDuration(left) .. " left."
	end

	tab:Section("Key")
	tab:Label({ Text = keyStatus(), Update = keyStatus, UpdateRate = 1 })

	-- Echeance atteinte (os.clock, ou heure du PC en secours, au plus toutes les 5 min) : le serveur est interroge.
	-- Il donne le temps restant -> echeance reprogrammee ; sinon (ou injoignable apres un 2e essai) tout s'arrete.
	if info.required ~= false and info.valid and info.recheck and not info.lifetime then
		task.spawn(function()
			local nextWall = 0
			while not self._dead do
				task.wait(5)
				local now = os.clock()
				local byDeadline = info.deadline ~= nil and now >= info.deadline
				local byWall = info.expires ~= nil and os.time() >= info.expires and now >= nextWall
				if byDeadline or byWall then
					nextWall = now + 300
					local result = info.recheck()
					if result == "offline" then
						task.wait(10)
						result = info.recheck()
					end
					if result == "expired" then
						self:_unload("Your key has expired. Relaunch the script to enter a new key.")
						return
					elseif result == "offline" then
						self:_unload("Could not re-check your key (server unreachable). Relaunch the script.")
						return
					end
					if info.lifetime then return end
				end
			end
		end)
	end

	tab:Section("Time with the scripts")
	tab:Label({
		Text = "Loading...",
		UpdateRate = 5,
		Update = function()
			local this = tonumber(pt.data.scripts[scriptName]) or 0
			return pt.data.name .. ": " .. fmtDuration(pt.data.total) .. " in total, " .. fmtDuration(pt.session)
				.. " this session, " .. fmtDuration(this) .. " on " .. tostring(scriptName)
		end,
	})
	local accounts = tab:Paragraph({ Title = "All accounts on this device", Content = "Loading..." })
	task.spawn(function()
		while not self._dead do
			local lines = {}
			for _, a in ipairs(readAccounts(pt)) do
				table.insert(lines, tostring(a.name) .. ": " .. fmtDuration(tonumber(a.total) or 0))
			end
			accounts:Set(table.concat(lines, "\n"))
			task.wait(30)
		end
	end)

	if info.lifetime then
		tab:Section("Lifetime key")
		tab:Label({ Text = "You own a lifetime key. Thank you!" })
	elseif info.shopUrl and info.shopUrl ~= "" then
		tab:Section("Lifetime key")
		tab:Paragraph({
			Title = "Buy once, no checkpoints",
			Content = "A lifetime key never expires and skips the checkpoints."
				.. ((info.shopPrice and info.shopPrice ~= "") and (" Price: " .. info.shopPrice .. ".") or ""),
		})
		tab:Button({ Name = "Copy the shop link", Desc = "Open it in your browser", Callback = function()
			pcall(function() (setclipboard or toclipboard)(info.shopUrl) end)
			Airflow:Notify({ Title = "Lifetime key", Content = "Shop link copied. Open it in your browser." })
		end })
	end
	if info.invite and info.invite ~= "" then
		tab:Button({ Name = "Copy the Discord invite", Callback = function()
			pcall(function() (setclipboard or toclipboard)(info.invite) end)
			Airflow:Notify({ Title = "Discord", Content = "Invite copied." })
		end })
	end
end

function Airflow:CreateWindow(cfg)
	local ui = loadWindUI()
	local save = cfg.ConfigurationSaving or {}
	local fileName = save.FileName or self.ScriptName
	local size = cfg.Size
	if typeof(size) ~= "UDim2" then size = UDim2.fromOffset(580, 420) end

	local w = ui:CreateWindow({
		Title = cfg.Name or self.ScriptName,
		Author = pick(cfg, "Subtitle", "LoadingSubtitle"),
		Icon = cfg.Icon,
		Folder = save.FolderName or "PassoliniHub",
		Size = size,
		ToggleKey = keycode(pick(cfg, "ToggleUIKeybind", "ToggleKey")),
		Transparent = cfg.Transparent,
		Theme = cfg.Theme,
		KeySystem = cfg.KeySystem,
	})

	local self_ = setmetatable({
		_w = w, _tabCount = 0, _fileName = fileName, _lastControl = os.clock(),
		Flags = Airflow.Flags, AutoLoad = save.Enabled ~= false,
	}, Window)
	table.insert(Airflow.Windows, self_)

	if save.Enabled ~= false then
		self_._cfg = w.ConfigManager:CreateConfig(fileName, false)
		self_._cfg.AutoLoad = false
		local parser = w.ConfigManager.Parser
		parser.CardGrid = {
			Save = function(obj) return { __type = "CardGrid", value = obj.Value } end,
			Load = function(element, data) element:Set(data.value) end,
		}
		local delay = save.AutoLoadDelay or 1.5
		task.spawn(function()
			task.wait(2)
			while not self_._dead and os.clock() - self_._lastControl < delay do task.wait(0.25) end
			if self_._dead then return end
			if isfile(self_._cfg.Path) then
				pcall(function() self_._cfg:Load() end)
			else
				pcall(function() self_._cfg:Save() end)
			end
			self_._ready = true
		end)
	else
		self_._cfg = { Register = function() end, Save = function() end, Load = function() end, Path = "" }
	end

	if self.ScriptName and cfg.OpenButton ~= false then
		pcall(function() w:EditOpenButton({ Title = cfg.Name or self.ScriptName }) end)
	end

	if self._mainCredit then
		local credit = self._mainCredit
		local main = self_:CreateTab(credit.TabName or "Main", credit.Icon or "home")
		if credit.Discord then
			main:Button({ Name = "Discord", Desc = "Copy the invite link", Callback = function()
				pcall(function() (setclipboard or toclipboard)(credit.Discord) end)
				Airflow:Notify({ Title = "Discord", Content = "Invite copied." })
			end })
		end
		local exec = "unknown"
		pcall(function() exec = identifyexecutor() end)
		main:Label({ Text = "Executor: " .. tostring(exec) })
	end

	if cfg.KeyInfo then
		self_:_keyTab(cfg.KeyInfo, save.FolderName or "PassoliniHub", self.ScriptName)
	end

	return self_
end

local function control(tab, cfg, state, el, get, set)
	state.muted = false
	local C = setmetatable({}, { __index = function(_, k) return el[k] end })
	C.Get = get
	C.Set = function(_, value, silent)
		if silent then state.muted = true end
		pcall(set, value)
		state.muted = false
	end
	if cfg.Flag then Airflow.Flags[cfg.Flag] = C end
	tab.Window:_touch()
	return C
end

local function guard(tab, cfg, state, convert)
	return function(...)
		if state.muted then return end
		if cfg.Callback then
			if convert then cfg.Callback(convert(...)) else cfg.Callback(...) end
		end
		tab.Window:_autoSave()
	end
end

function Tab:Section(name)
	local cfg = norm(name)
	self.Window:_touch()
	return self._t:Section({ Title = cfg.Name or cfg.Title or cfg.Text, Opened = true })
end

function Tab:Divider() self.Window:_touch() return self._t:Divider() end

function Tab:Paragraph(cfg)
	cfg = norm(cfg)
	local el = self._t:Paragraph({ Title = pick(cfg, "Title", "Name") or "", Desc = pick(cfg, "Content", "Desc") })
	self.Window:_touch()
	return setmetatable({
		Set = function(_, v)
			if type(v) == "table" then
				if v.Title and el.SetTitle then el:SetTitle(v.Title) end
				if v.Content and el.SetDesc then el:SetDesc(v.Content) end
			elseif el.SetDesc then
				el:SetDesc(tostring(v))
			end
		end,
	}, { __index = el })
end

function Tab:Label(cfg)
	cfg = norm(cfg)
	local el = self._t:Paragraph({ Title = pick(cfg, "Text", "Name") or "" })
	self.Window:_touch()
	local win = self.Window
	if cfg.Update then
		task.spawn(function()
			while not win._dead do
				local ok, text = pcall(cfg.Update)
				if ok and text ~= nil then pcall(function() el:SetTitle(tostring(text)) end) end
				task.wait(cfg.UpdateRate or 1)
			end
		end)
	end
	return setmetatable({ Set = function(_, v) pcall(function() el:SetTitle(tostring(v)) end) end }, { __index = el })
end

function Tab:Button(cfg)
	cfg = norm(cfg)
	local el = self._t:Button({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Icon = cfg.Icon,
		Callback = function() if cfg.Callback then cfg.Callback() end end,
	})
	self.Window:_touch()
	return setmetatable({ SetText = function(_, t) pcall(function() el:SetTitle(t) end) end }, { __index = el })
end

function Tab:Toggle(cfg)
	cfg = norm(cfg)
	local state = { muted = true }
	local el = self._t:Toggle({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Value = pick(cfg, "Default", "CurrentValue") == true,
		Callback = guard(self, cfg, state),
	})
	local C = control(self, cfg, state, el, function() return el.Value end, function(v) el:Set(v and true or false) end)
	C._isToggle = true
	return C
end

function Tab:Slider(cfg)
	cfg = norm(cfg)
	local range = cfg.Range or {}
	local min, max = pick(cfg, "Min") or range[1] or 0, pick(cfg, "Max") or range[2] or 100
	local default = pick(cfg, "Default", "CurrentValue") or min
	local state = { muted = true }
	local el = self._t:Slider({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Step = pick(cfg, "Step", "Increment") or 1,
		Value = { Min = min, Max = max, Default = default },
		Callback = guard(self, cfg, state),
	})
	return control(self, cfg, state, el, function() return el.Value.Default end, function(v) el:Set(v) end)
end
Tab.Stepper = Tab.Slider

function Tab:Progress(cfg)
	cfg = norm(cfg)
	local el = self._t:ProgressBar({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc,
		Value = { Min = 0, Max = 1, Default = cfg.Default or 0 },
	})
	self.Window:_touch()
	return el
end

function Tab:Dropdown(cfg)
	cfg = norm(cfg)
	local multi = pick(cfg, "Multi", "MultipleOptions") == true
	local default = pick(cfg, "Default", "CurrentOption")
	if multi then
		default = type(default) == "table" and copyList(default) or (default and { default } or {})
	elseif type(default) == "table" then
		default = default[1]
	end
	local state = { muted = true }
	local el = self._t:Dropdown({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Values = copyList(cfg.Options or cfg.Values or {}),
		Value = default, Multi = multi, AllowNone = true,
		SearchBarEnabled = cfg.SearchAfter ~= nil,
		Callback = guard(self, cfg, state, function(v)
			if multi and type(v) == "table" then return copyList(v) end
			return v
		end),
	})
	local C = control(self, cfg, state, el, function()
		if multi then return copyList(el.Value or {}) end
		return el.Value
	end, function(v)
		if multi then
			el:Select(type(v) == "table" and copyList(v) or { v })
		else
			el:Select(type(v) == "table" and v[1] or v)
		end
	end)
	function C:Refresh(options, keep)
		state.muted = true
		pcall(function() el:Refresh(copyList(options)) end)
		state.muted = false
	end
	return C
end

function Tab:Input(cfg)
	cfg = norm(cfg)
	local state = { muted = true }
	local el = self._t:Input({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Placeholder = pick(cfg, "Placeholder", "PlaceholderText"),
		Value = tostring(pick(cfg, "Default", "CurrentValue") or ""),
		Callback = guard(self, cfg, state, function(text) return text, false end),
	})
	return control(self, cfg, state, el, function() return el.Value end, function(v) el:Set(tostring(v)) end)
end

function Tab:Keybind(cfg)
	cfg = norm(cfg)
	local state = { muted = true }
	local default = pick(cfg, "Default", "CurrentKeybind")
	local el = self._t:Keybind({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Value = typeof(default) == "EnumItem" and default.Name or default or "F",
		Callback = guard(self, cfg, state),
	})
	local C = control(self, cfg, state, el, function() return el.Value end, function(v) el:Set(typeof(v) == "EnumItem" and v.Name or v) end)
	if cfg.OnChanged then
		local win, last = self.Window, el.Value
		task.spawn(function()
			while not win._dead do
				task.wait(0.4)
				if el.Value ~= last then
					last = el.Value
					pcall(cfg.OnChanged, last)
					win:_autoSave()
				end
			end
		end)
	end
	return C
end

function Tab:ColorPicker(cfg)
	cfg = norm(cfg)
	local state = { muted = true }
	local el = self._t:Colorpicker({
		Title = cfg.Name or cfg.Title, Desc = cfg.Desc, Flag = cfg.Flag,
		Default = pick(cfg, "Default", "Color") or Color3.new(1, 1, 1),
		Callback = guard(self, cfg, state),
	})
	return control(self, cfg, state, el, function() return el.Default end, function(v) el:Update(v) end)
end

local function themeColors()
	local ui = loadWindUI()
	local theme = ui:GetThemes()[ui:GetCurrentTheme()] or {}
	return {
		card = theme.ElementBackground or Color3.fromRGB(42, 42, 44),
		text = theme.Text or Color3.new(1, 1, 1),
		accent = theme.Primary or theme.Slider or Color3.fromRGB(0, 145, 255),
	}
end

local function buildGrid(tab, cfg, grouped)
	local colors = themeColors()
	local columns = cfg.Columns or (grouped and 4 or 3)
	local cardHeight = cfg.CardHeight or 34
	local selected, items, groups, groupLabel = {}, {}, {}, nil
	local muted = true
	local gridObj = { __type = "CardGrid", Value = {} }

	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.Size = UDim2.new(1, 0, 0, 0)
	root.AutomaticSize = Enum.AutomaticSize.Y
	local rootList = Instance.new("UIListLayout")
	rootList.Padding = UDim.new(0, 6)
	rootList.SortOrder = Enum.SortOrder.LayoutOrder
	rootList.Parent = root

	local function label(text, order)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, 18)
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Font = Enum.Font.GothamMedium
		l.TextSize = 14
		l.TextColor3 = colors.text
		l.Text = text
		l.LayoutOrder = order
		l.Parent = root
		return l
	end
	local header = (cfg.Name or cfg.Desc) and label(cfg.Name or cfg.Desc, 1)

	local filterBar
	if grouped then
		filterBar = Instance.new("Frame")
		filterBar.BackgroundTransparency = 1
		filterBar.Size = UDim2.new(1, 0, 0, 0)
		filterBar.AutomaticSize = Enum.AutomaticSize.Y
		filterBar.LayoutOrder = 2
		filterBar.Parent = root
		local fl = Instance.new("UIListLayout")
		fl.FillDirection = Enum.FillDirection.Horizontal
		fl.Wraps = true
		fl.Padding = UDim.new(0, 4)
		fl.Parent = filterBar
	end

	local area = Instance.new("Frame")
	area.BackgroundTransparency = 1
	area.Size = UDim2.new(1, 0, 0, 0)
	area.LayoutOrder = 3
	area.Parent = root
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.CellSize = UDim2.new(1 / columns, -math.ceil(6 * (columns - 1) / columns), 0, cardHeight)
	grid.Parent = area
	local function fit()
		area.Size = UDim2.new(1, 0, 0, grid.AbsoluteContentSize.Y)
	end
	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)

	local cards = {}
	local function paint(name)
		local card = cards[name]
		if not card then return end
		local on = selected[name] == true
		card.BackgroundColor3 = on and colors.accent or colors.card
		card.TextTransparency = on and 0 or 0.25
	end

	local function snapshot()
		local list = {}
		for name in pairs(selected) do table.insert(list, name) end
		table.sort(list)
		return list
	end

	local function changed()
		gridObj.Value = snapshot()
		if muted then return end
		if cfg.Callback then
			local copy = {}
			for k, v in pairs(selected) do copy[k] = v end
			cfg.Callback(copy)
		end
		tab.Window:_autoSave()
	end

	local function render(list)
		for _, c in pairs(cards) do c:Destroy() end
		cards = {}
		local order = 0
		for _, item in ipairs(list) do
			local name = type(item) == "table" and item.Name or item
			order = order + 1
			local card = Instance.new("TextButton")
			card.AutoButtonColor = false
			card.BorderSizePixel = 0
			card.Font = Enum.Font.GothamMedium
			card.TextSize = 13
			card.TextColor3 = colors.text
			card.TextWrapped = true
			card.Text = name
			card.LayoutOrder = order
			card.Parent = area
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 8)
			corner.Parent = card
			cards[name] = card
			paint(name)
			card.MouseButton1Click:Connect(function()
				if selected[name] then selected[name] = nil else selected[name] = true end
				paint(name)
				changed()
			end)
			if cfg.OnCardCreated then task.spawn(pcall, cfg.OnCardCreated, name, card) end -- comme Airflow : le callback peut boucler
		end
		fit()
	end

	local function currentItems()
		if not grouped then return items end
		for _, g in ipairs(groups) do
			if g.Label == groupLabel then return g.Items end
		end
		return {}
	end

	local function renderFilter()
		if not filterBar then return end
		for _, c in ipairs(filterBar:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for i, g in ipairs(groups) do
			local b = Instance.new("TextButton")
			b.AutoButtonColor = false
			b.AutomaticSize = Enum.AutomaticSize.X
			b.Size = UDim2.fromOffset(0, 26)
			b.BorderSizePixel = 0
			b.Font = Enum.Font.GothamMedium
			b.TextSize = 12
			b.TextColor3 = colors.text
			b.BackgroundColor3 = g.Label == groupLabel and colors.accent or colors.card
			b.Text = "  " .. g.Label .. "  "
			b.LayoutOrder = i
			b.Parent = filterBar
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 7)
			corner.Parent = b
			b.MouseButton1Click:Connect(function()
				groupLabel = g.Label
				renderFilter()
				render(currentItems())
			end)
		end
	end

	root.Parent = tab._t.UIElements.ContainerFrame
	tab.Window:_touch()

	local C = { _type = "CardGrid" }
	function C:SetItems(list) items = list or {} render(currentItems()) end
	function C:SetGroups(list)
		groups = list or {}
		local found = false
		for _, g in ipairs(groups) do if g.Label == groupLabel then found = true end end
		if not found then groupLabel = groups[1] and groups[1].Label end
		renderFilter()
		render(currentItems())
	end
	function C:SetGroup(name) groupLabel = name renderFilter() render(currentItems()) end
	function C:GetSelected() return snapshot() end
	C.Get = C.GetSelected
	function C:SetSelected(value, silent)
		selected = {}
		if type(value) == "table" then
			for k, v in pairs(value) do
				if type(k) == "number" then selected[v] = true elseif v then selected[k] = true end
			end
		end
		for name in pairs(cards) do paint(name) end
		if silent then
			muted = true
			changed()
			muted = false
		else
			changed()
		end
	end
	C.Set = function(self, value, silent) return C.SetSelected(self, value, silent) end
	function C:SelectAll(group)
		local list = group and (function()
			for _, g in ipairs(groups) do if g.Label == group then return g.Items end end
		end)() or currentItems()
		for _, item in ipairs(list or {}) do selected[type(item) == "table" and item.Name or item] = true end
		for name in pairs(cards) do paint(name) end
		changed()
	end
	function C:DeselectAll()
		selected = {}
		for name in pairs(cards) do paint(name) end
		changed()
	end
	C.Value = gridObj.Value

	if grouped then
		C:SetGroups(cfg.Groups)
	else
		C:SetItems(cfg.Items)
	end
	if cfg.Default then C:SetSelected(cfg.Default, true) end

	setmetatable(gridObj, { __index = C })
	if cfg.Flag then
		Airflow.Flags[cfg.Flag] = C
		tab.Window._cfg:Register(cfg.Flag, gridObj)
	end
	muted = false
	return C
end

function Tab:CardGrid(cfg) return buildGrid(self, norm(cfg), false) end
function Tab:FilteredCardGrid(cfg) return buildGrid(self, norm(cfg), true) end

function Tab:ConfigManager(cfg)
	cfg = norm(cfg)
	local win = self.Window
	self:Section("Configs")
	local name = ""
	local list = win:ListConfigs()
	local dd
	self:Input({ Name = "Config name", Placeholder = "my-config", Callback = function(v) name = v end })
	dd = self:Dropdown({ Name = "Saved configs", Options = list, Callback = function(v) if type(v) == "string" then name = v end end })
	local function refresh() dd:Refresh(win:ListConfigs()) end
	self:Button({ Name = "Save", Callback = function()
		if name ~= "" then win:SaveConfig(name) refresh() Airflow:Notify({ Title = "Config", Content = "Saved " .. name }) end
	end })
	self:Button({ Name = "Load", Callback = function()
		if name ~= "" then
			local ok = win:LoadConfig(name)
			Airflow:Notify({ Title = "Config", Content = ok and ("Loaded " .. name) or "Not found" })
		end
	end })
	self:Button({ Name = "Delete", Callback = function()
		if name ~= "" then win:DeleteConfig(name) refresh() end
	end })
end

for _, method in ipairs({
	"Section", "Divider", "Paragraph", "Label", "Button", "Toggle", "Slider", "Stepper", "Progress", "Dropdown",
	"Input", "Keybind", "ColorPicker", "CardGrid", "FilteredCardGrid", "ConfigManager",
}) do
	Tab["Create" .. method] = Tab[method]
end
Tab.RichParagraph = Tab.Paragraph
Tab.CreateRichParagraph = Tab.Paragraph

return Airflow
